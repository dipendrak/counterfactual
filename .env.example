NESSIE_API_KEY=
# Verified production origin. Get a key at https://prod.nessieisreal.com/.
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
COUNTERFACTUAL_CACHE_DIR=data/cache
COUNTERFACTUAL_DB_PATH=data/runs.sqlite3
# Dev D's frontend origin. /r/{run_id} is owned by Dev D.
REPLAY_BASE_URL=http://localhost:3000
# auto loads Dev C's llm.parse if installed, otherwise uses a narrow offline parser.
# llm requires Dev C; explicit always uses the offline parser.
COUNTERFACTUAL_PARSER=auto
# Needed by Dev C's Gemini implementation, not by ingest or simulation.
GEMINI_API_KEY=
